const int ENA = 9;   
const int IN1 = 7;  
const int IN2 = 6;
const int IN3 = 5;   
const int IN4 = 4;
const int ENB = 3;   

const long BT_BAUD     = 9600;   
const int  SPEED       = 200;    
const int  TURN_SPEED  = 170;    
const unsigned long TIMEOUT = 500; 

const bool TEST_MODE = false;

unsigned long lastCmdTime = 0;
char currentCmd = 'S';



void motor(int en, int inA, int inB, int dir, int spd) {
  if (dir > 0)      { digitalWrite(inA, HIGH); digitalWrite(inB, LOW);  }
  else if (dir < 0) { digitalWrite(inA, LOW);  digitalWrite(inB, HIGH); }
  else              { digitalWrite(inA, LOW);  digitalWrite(inB, LOW);  spd = 0; }
  analogWrite(en, spd);   

void leftMotor(int dir, int spd)  { motor(ENA, IN1, IN2, dir, spd); }
void rightMotor(int dir, int spd) { motor(ENB, IN3, IN4, dir, spd); }

void forward()  { leftMotor( 1, SPEED);      rightMotor( 1, SPEED);      }
void backward() { leftMotor(-1, SPEED);      rightMotor(-1, SPEED);      }
void turnLeft() { leftMotor(-1, TURN_SPEED); rightMotor( 1, TURN_SPEED); }
void turnRight(){ leftMotor( 1, TURN_SPEED); rightMotor(-1, TURN_SPEED); }
void stopCar()  { leftMotor( 0, 0);          rightMotor( 0, 0);          }

void execute(char c) {
  switch (c) {
    case 'F': forward();   break;
    case 'B': backward();  break;
    case 'L': turnLeft();  break;
    case 'R': turnRight(); break;
    default:  stopCar();   break;   
  }
}

-
void runTest() {
  const char seq[] = {'F', 'S', 'B', 'S', 'L', 'S', 'R', 'S'};
  for (char c : seq) {
    execute(c);
    delay(c == 'S' ? 700 : 1500);
  }
}

void setup() {
  pinMode(ENA, OUTPUT); pinMode(ENB, OUTPUT);
  pinMode(IN1, OUTPUT); pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT); pinMode(IN4, OUTPUT);
  pinMode(LED_BUILTIN, OUTPUT);
  stopCar();

  Serial.begin(BT_BAUD);      
  delay(1000);                

  if (TEST_MODE) {
    runTest();
    while (true) {}           
  }
}


void loop() {
  
  while (Serial.available()) {
    char c = Serial.read();
    if (c == 'F' || c == 'B' || c == 'L' || c == 'R' || c == 'S') {
      lastCmdTime = millis();
      if (c != currentCmd) {
        currentCmd = c;
        execute(currentCmd);
      }
    }


  if (currentCmd != 'S' && millis() - lastCmdTime > TIMEOUT) {
    currentCmd = 'S';
    stopCar();
  }

  digitalWrite(LED_BUILTIN, currentCmd != 'S');
}
